# ─── Kick kanalı ──────────────────────────────────────────────────────────────
KICK_CHANNEL_SLUG="sostevie"
# Chat'in Pusher odası. sostevie için hazır; başka kanalda kanal sayfasında
# DevTools > Network > WS'te "chatrooms.<ID>.v2" aboneliğinden okunur.
KICK_CHATROOM_ID="25098810"
# Panelde/overlay'de hiç görünmesin istediğin hesaplar (virgülle)
BLOCKED_USERS="botrix"

# ─── Profil fotoğrafı (opsiyonel) ─────────────────────────────────────────────
# kick.com/settings/developer'dan alınan uygulama bilgileri. Boş bırakılırsa
# overlay'de kullanıcının baş harfi + chat rengiyle avatar çizilir.
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""

# ─── LLM zinciri (sırayla denenir; biri kota yerse diğerine geçer) ────────────
# En az birini doldur. Hepsi ücretsiz katmanla çalışır.
GROQ_API_KEY=""
# Sirayla denenir; her modelin ayri gunluk kotasi var.
GROQ_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b"

CEREBRAS_API_KEY=""
CEREBRAS_MODEL="llama3.1-8b"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ─── Seslendirme ──────────────────────────────────────────────────────────────
# Microsoft Edge neural TTS — ücretsiz, anahtar gerekmez.
TTS_VOICE="tr-TR-EmelNeural"

PORT="3200"
